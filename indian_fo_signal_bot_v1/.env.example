# ==============================================================================
# TradePulse & OrderBlock AI — Phase 2B Environment Configuration Template
# Copy this file to `.env` locally and replace placeholders with your own keys.
# NEVER commit `.env` or share real credentials in chat or logs.
# ==============================================================================

# Active Market Data Provider: "paper_sim", "angelone", "dhan", or "upstox"
ACTIVE_BROKER=paper_sim

# ------------------------------------------------------------------------------
# 1. Angel One SmartAPI (Read-Only Market Data Integration — Phase 2A / 2B)
#    Official Endpoints Used:
#      - POST https://apiconnect.angelbroking.com/rest/auth/angelbroking/user/v1/loginByPassword
#      - POST https://apiconnect.angelbroking.com/rest/auth/angelbroking/jwt/v1/generateTokens
#      - GET  https://apiconnect.angelbroking.com/rest/secure/angelbroking/user/v1/getProfile
#      - POST https://apiconnect.angelbroking.com/rest/secure/angelbroking/market/v1/quote/
#      - POST https://apiconnect.angelbroking.com/rest/secure/angelbroking/historical/v1/getCandleData
#      - POST https://apiconnect.angelbroking.com/rest/secure/angelbroking/marketData/v1/optionGreek
#      - GET  https://apiconnect.angelbroking.com/rest/secure/angelbroking/marketData/v1/putCallRatio
#    NOTE: ANGEL_TOTP_SECRET must be the Base32 TOTP seed from Angel One's
#          "Enable TOTP" page (e.g., JBSWY3DPEHPK3PXP), NOT a 6-digit one-time code.
# ------------------------------------------------------------------------------
ANGEL_API_KEY=your_angel_smartapi_private_key
ANGEL_CLIENT_CODE=your_angel_client_code
ANGEL_PIN=your_angel_4_digit_mpin
ANGEL_TOTP_SECRET=your_angel_totp_base32_seed
ANGEL_SCRIP_MASTER_PATH=
ANGEL_SCRIP_MASTER_MAX_AGE_HOURS=24.0
ANGEL_BASELINE_MAX_SESSIONS_AGE=1
ANGEL_REQUEST_TIMEOUT_SECONDS=8.0
ANGEL_MIN_REQUEST_INTERVAL_SECONDS=0.0

# ------------------------------------------------------------------------------
# 2. DhanHQ API v2 (Read-Only Market Data)
# ------------------------------------------------------------------------------
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_jwt_access_token
# Optional explicit canonical scope; does not start streaming or change provider.
DHAN_FEED_INSTRUMENTS_JSON=[]

# ------------------------------------------------------------------------------
# 3. Upstox Developer API v2 (Read-Only Market Data)
# ------------------------------------------------------------------------------
# The current adapter consumes a pre-issued OAuth bearer access token.
# API key is retained for configuration compatibility; it is not sent by this adapter
# and cannot substitute for UPSTOX_ACCESS_TOKEN. No OAuth exchange/refresh is implemented.
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_ACCESS_TOKEN=your_upstox_oauth_access_token

# ------------------------------------------------------------------------------
# 4. Telegram Bot Signal Dispatcher
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_DRY_RUN=true

# ------------------------------------------------------------------------------
# 5. Risk, Capital & Market Session Settings (Asia/Kolkata IST)
# ------------------------------------------------------------------------------
ACCOUNT_CAPITAL_INR=150000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_INR=2000
DAILY_PROFIT_TARGET_INR=4000
MAX_CONCURRENT_POSITIONS=1
SCAN_INTERVAL_SECONDS=60
SESSION_START_IST=09:15
SESSION_END_IST=15:30
NSE_HOLIDAYS=

# ------------------------------------------------------------------------------
# 6. Persistence & Server Settings
# ------------------------------------------------------------------------------
ENABLE_PERSISTENCE=true
DATABASE_URL=sqlite:///tradepulse_phase1d.db
ENABLE_BACKGROUND_SCHEDULER=false
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
